# NextStep scraper — production environment template.
# Copy to .env (never commit .env) and fill in real values.
# Every value below is optional except MONGO_URI; unset means safe defaults.

# --- Required ---------------------------------------------------------------
# MongoDB connection for BOTH the app and the scraper staging collections.
MONGO_URI=mongodb://127.0.0.1:27017/nextstep

# --- Server auth (required for the app backend) -------------------------------
# PORT=5000                   # API listen port (default 5000)
# MONGO_URI=                  # (see Required above; server uses the same key)
# JWT_SECRET=                 # long random string for signing access JWTs
# GOOGLE_CLIENT_ID=           # OAuth client ID for "Continue with Google"

# --- Email OTP verification (AWS SES SMTP via Nodemailer) --------------------
# All five are required to SEND verification mail. With any missing, signup
# still creates the pending account but reports emailSent:false (no fake
# "sent" claims, no secrets in responses/logs).
# SMTP_HOST=email-smtp.<region>.amazonaws.com  # region-specific SES endpoint
# SMTP_PORT=587               # 587 = STARTTLS | 465 = implicit TLS
# SMTP_USER=                  # SES SMTP username (IAM-derived, keep secret)
# SMTP_PASS=                  # SES SMTP password (keep secret, never commit)
# EMAIL_FROM=                 # verified SES sender, e.g. "NextStep <no-reply@yourdomain>"
# OTP_TTL_MINUTES=10          # code lifetime (default 10)
# OTP_MAX_ATTEMPTS=5          # wrong-code attempts per code (default 5)
# OTP_RESEND_COOLDOWN_SECONDS=60   # per-email resend cooldown (default 60)
# OTP_MAX_RESENDS_PER_HOUR=5  # per-email hourly resend budget (default 5)

# --- Scraper overrides (optional) -------------------------------------------
# SCRAPER_MONGO_URI=            # staging URI if different from MONGO_URI
# CRAWLEE_TRANSPORT=off         # off (default) | shadow | on (experimental)
# PYTHON_DOCPROC_URL=http://127.0.0.1:8001   # Python specialist service
# DRY_RUN=true                  # any value except "false" keeps dry-run posture

# --- Step 7 local LLM (disabled by default; never required) -----------------
# LLM_SEMANTIC_EXTRACTION=false # "true" enables the local proposer only
# LLM_PROVIDER_URL=http://127.0.0.1:11434    # local Ollama-compatible server
# LLM_MODEL=                    # local model name (required when enabled)

# --- Step 13/14 operations (optional) ---------------------------------------
# OPS_LOG_DIR=                  # JSON-lines log directory (default: stdout)
# OPS_LOG_MAX_BYTES=10485760    # per-file cap before rotation (default 10MB)
# NOTIFICATIONS_ENABLED=false   # "true" enables delivery beyond local log
# NOTIFICATIONS_TRANSPORT=log   # log (default) | file | webhook
# NOTIFICATIONS_FILE_DIR=       # spool directory for the file transport
# NOTIFICATIONS_WEBHOOK_URL=    # destination for the webhook transport
# OPS_LOCK_FILE=                # overlap-guard path (default: OS temp dir)
# OPS_BACKUP_DIR=               # JSON export destination for backups
